# Copy to .env for ./gradlew bootRun. Every setting and its default is in
# src/main/resources/application.yml; names match the Go services' where
# they overlap.

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=billing_db
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=10

API_PORT=8084

KAFKA_BROKERS=localhost:9092

KAFKA_CONSUMER_GROUP=billing-service

# Stripe test-mode keys outside production. Without STRIPE_SECRET_KEY the
# service starts and payment endpoints answer 503. The webhook secret is what
# `stripe listen --forward-to localhost:8084/webhooks/stripe` prints.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE=
STRIPE_RETURN_URL=http://localhost:5173/payments/return

# Must match identity-service.
JWT_SECRET=local-dev-jwt-secret-change-me-0123456789
JWT_ISSUER=identity-service

CUSTOMER_API_URL=http://localhost:8080/api/v1
VEHICLE_API_URL=http://localhost:8081/api/v1
SCHEDULER_API_URL=http://localhost:8085/api/v1

# Bills: currency must match scheduler-service's CATALOG_CURRENCY. The
# warranty fee and deposit policy are placeholders until business-requirement
# §10 #5 and #6 are decided.
BILLING_CURRENCY=USD
BILLING_WARRANTY_FEE=50.00
BILLING_TIME_ZONE=Asia/Ho_Chi_Minh
DEPOSIT_POLICY=PERCENT
DEPOSIT_VALUE=20

LOG_LEVEL=info
