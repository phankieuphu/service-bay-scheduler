# Copy to .env for ./gradlew bootRun. Every setting and its default is in
# src/main/resources/application.yml; names match the Go services' where
# they overlap.

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=billing_db
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=10

API_PORT=8084

KAFKA_BROKERS=localhost:9092

# Stripe (test-mode keys outside production). Added by the Stripe
# integration; unused until then.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

LOG_LEVEL=info
