# Copy to .env for `go run ./cmd/server`. Every variable and its default is
# defined in config/config.go.

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=identity_db
DB_SSLMODE=disable

API_PORT=8083

KAFKA_BROKERS=localhost:9092
KAFKA_PRODUCER_TOPIC=identity.user-events

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Required, at least 32 bytes. Must match any service that validates tokens itself.
JWT_SECRET=local-dev-jwt-secret-change-me-0123456789
JWT_ISSUER=identity-service
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=604800

LOG_LEVEL=info
LOG_FORMAT=json
