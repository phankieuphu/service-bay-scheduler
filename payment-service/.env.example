# Copy to .env (gitignored). Every variable and its default is in
# src/main/resources/application.properties.

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=payment_db
DB_SSLMODE=disable

SERVER_PORT=8085
KAFKA_BROKERS=localhost:9092

# Stripe test-mode keys from https://dashboard.stripe.com/test/apikeys.
# Unset = card endpoints and the webhook answer 503; the rest still runs.
STRIPE_SECRET_KEY=sk_test_...
# Printed by `stripe listen --forward-to localhost:8085/api/v1/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: point at stripe-mock instead of api.stripe.com.
STRIPE_API_BASE=
