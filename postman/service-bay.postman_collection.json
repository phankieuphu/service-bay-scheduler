            {
              "name": "Prometheus metrics",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{vehicleUrl}}/metrics",
                  "host": [
                    "{{vehicleUrl}}"
                  ],
                  "path": [
                    "metrics"
                  ]
                },
                "description": "",
                "auth": {
                  "type": "noauth"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Billing Service",
      "description": "billing_service (Spring Boot, :8084).",
      "item": [
        {
          "name": "Create bill",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{billingUrl}}/api/v1/bills",
              "host": [
                "{{billingUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "bills"
              ]
            },
            "description": "appointmentId/customerId/vehicleId required; fees must be non-negative.",
