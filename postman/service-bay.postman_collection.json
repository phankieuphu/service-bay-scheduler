                ]
              }
            }
          ]
        },
        {
          "name": "List customers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{customerUrl}}/api/v1/customer?limit=20&cursor=0",
              "host": [
                "{{customerUrl}}"
              ],
              "path": [
                "api",
