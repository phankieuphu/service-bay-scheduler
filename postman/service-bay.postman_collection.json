    {
      "name": "Vehicle Service",
      "description": "vehicle-service (:8081).",
      "item": [
        {
          "name": "Register vehicle",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{vehicleUrl}}/api/v1/vehicle",
              "host": [
                "{{vehicleUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "vehicle"
              ]
            },
            "description": "status: ACTIVE (default) | SOLD | SCRAPPED. VIN/plate normalized server-side.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vin\": \"{{randomVin}}\",\n  \"license_plate\": \"51A-123.45\",\n  \"vehicle_model_id\": 1,\n  \"warranty_end_date\": \"2028-12-31T00:00:00Z\",\n  \"status\": \"ACTIVE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const c = 'ABCDEFGHJKLMNPRSTUVWXYZ0123456789';",
                  "let v = ''; for (let i = 0; i < 17; i++) v += c[Math.floor(Math.random() * c.length)];",
                  "pm.collectionVariables.set('randomVin', v);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) { const j = pm.response.json(); if (j.id !== undefined) pm.collectionVariables.set('vehicleId', j.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "List vehicles",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{vehicleUrl}}/api/v1/vehicle?limit=20&cursor=0",
              "host": [
                "{{vehicleUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "vehicle"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20",
                  "description": ""
                },
                {
                  "key": "cursor",
                  "value": "0",
                  "description": ""
                },
                {
                  "key": "vin",
                  "value": "",
                  "description": "Filter by VIN",
                  "disabled": true
                },
                {
                  "key": "plate",
                  "value": "",
                  "description": "Filter by license plate",
                  "disabled": true
                },
                {
                  "key": "status",
                  "value": "ACTIVE",
                  "description": "ACTIVE | SOLD | SCRAPPED",
                  "disabled": true
                }
              ]
            },
            "description": "Cursor-paginated with optional filters.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Get vehicle",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{vehicleUrl}}/api/v1/vehicle/{{vehicleId}}",
              "host": [
                "{{vehicleUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "vehicle",
                "{{vehicleId}}"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) { const j = pm.response.json(); if (j.updated_at !== undefined) pm.collectionVariables.set('vehicleUpdatedAt', j.updated_at); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Update vehicle",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{vehicleUrl}}/api/v1/vehicle/{{vehicleId}}",
              "host": [
                "{{vehicleUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "vehicle",
                "{{vehicleId}}"
              ]
            },
            "description": "Omitted fields unchanged. updated_at must match last read value, otherwise 409.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACTIVE\",\n  \"warranty_end_date\": \"2029-12-31T00:00:00Z\",\n  \"updated_at\": \"{{vehicleUpdatedAt}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Assign initial owner",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{vehicleUrl}}/api/v1/vehicle/{{vehicleId}}/owner",
              "host": [
                "{{vehicleUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "vehicle",
                "{{vehicleId}}",
                "owner"
              ]
            },
            "description": "Optional \"date\" (RFC3339) \u2014 defaults to today, cannot be in the future.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": {{customerId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Transfer vehicle",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{vehicleUrl}}/api/v1/transfer",
              "host": [
                "{{vehicleUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transfer"
              ]
            },
            "description": "Optional \"date\" (RFC3339). Row-locked: concurrent transfers serialize.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicle_id\": {{vehicleId}},\n  \"from\": {{customerId}},\n  \"to\": {{targetCustomerId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
