              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane.{{$timestamp}}@example.com\",\n  \"phone\": \"+84901234567\",\n  \"birth_day\": \"1990-05-20T00:00:00Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
