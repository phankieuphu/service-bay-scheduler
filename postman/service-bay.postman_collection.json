{
  "info": {
    "name": "Service Bay",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "All HTTP APIs for Service Bay. Run Identity > Register/Login first; create/register requests store IDs (customerId, vehicleId, billId) into collection variables for later requests."
  },
  "item": [
    {
      "name": "Identity Service",
      "description": "identity-service (:8083). Auth + JWT issuing.",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{identityUrl}}/api/v1/auth/register",
              "host": [
                "{{identityUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "Role: CUSTOMER (default) | TECHNICIAN | MANAGER | ADMIN. Password 8-72 chars.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\",\n  \"role\": \"CUSTOMER\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) { const j = pm.response.json(); if (j.id !== undefined) pm.collectionVariables.set('userId', j.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{identityUrl}}/api/v1/auth/login",
              "host": [
                "{{identityUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Stores accessToken / refreshToken in collection variables.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) { const j = pm.response.json(); if (j.access_token !== undefined) pm.collectionVariables.set('accessToken', j.access_token); }",
                  "if (pm.response.code < 300) { const j = pm.response.json(); if (j.refresh_token !== undefined) pm.collectionVariables.set('refreshToken', j.refresh_token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{identityUrl}}/api/v1/auth/refresh",
              "host": [
                "{{identityUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "refresh"
              ]
            },
            "description": "Rotates the token pair.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) { const j = pm.response.json(); if (j.access_token !== undefined) pm.collectionVariables.set('accessToken', j.access_token); }",
                  "if (pm.response.code < 300) { const j = pm.response.json(); if (j.refresh_token !== undefined) pm.collectionVariables.set('refreshToken', j.refresh_token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{identityUrl}}/api/v1/me",
              "host": [
                "{{identityUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "me"
              ]
            },
            "description": "Requires Authorization: Bearer <access token>.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{identityUrl}}/api/v1/auth/logout",
              "host": [
                "{{identityUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "logout"
              ]
            },
            "description": "Revokes the refresh token. 204 on success.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Ops",
          "item": [
            {
              "name": "Liveness",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{identityUrl}}/healthz",
                  "host": [
                    "{{identityUrl}}"
                  ],
                  "path": [
                    "healthz"
                  ]
                },
                "description": "Liveness probe (go-health-check).",
                "auth": {
                  "type": "noauth"
                }
              }
            },
            {
              "name": "Readiness",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{identityUrl}}/readyz",
                  "host": [
                    "{{identityUrl}}"
                  ],
                  "path": [
                    "readyz"
                  ]
                },
                "description": "Readiness probe: checks Postgres/Kafka/Redis dependencies.",
                "auth": {
                  "type": "noauth"
                }
              }
            },
            {
              "name": "Prometheus metrics",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{identityUrl}}/metrics",
                  "host": [
                    "{{identityUrl}}"
                  ],
                  "path": [
                    "metrics"
                  ]
                },
                "description": "",
                "auth": {
                  "type": "noauth"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Customer Service",
