              "raw": "{{vehicleUrl}}/api/v1/customers/{{customerId}}/vehicles",
              "host": [
                "{{vehicleUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customers",
                "{{customerId}}",
                "vehicles"
              ]
            },
            "description": "",
