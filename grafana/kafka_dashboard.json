          },
          "expr": "sum by (consumergroup, topic) (kafka_consumergroup_lag{job=\"$job\", topic=~\"$topic\", consumergroup=~\"$consumergroup\"})",
          "legendFormat": "{{consumergroup}} \u2192 {{topic}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Lag divided by the current consume rate. It shows how long the group needs to finish the backlog if nothing new arrives. Empty when the group consumes nothing.",
      "id": 13,
