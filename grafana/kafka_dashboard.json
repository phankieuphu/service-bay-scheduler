        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (consumergroup, topic) (kafka_consumergroup_lag{job=\"$job\", topic=~\"$topic\", consumergroup=~\"$consumergroup\"}) / (sum by (consumergroup, topic) (rate(kafka_consumergroup_current_offset{job=\"$job\", topic=~\"$topic\", consumergroup=~\"$consumergroup\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{consumergroup}} \u2192 {{topic}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ]
