      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Messages waiting to be consumed, per group and topic. Small ups and downs are normal. A line that keeps going up means the consumer is too slow or stopped.",
      "id": 12,
      "title": "Lag per Consumer Group",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
