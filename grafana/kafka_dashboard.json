            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(kafka_topic_partitions{job=\"$job\", topic=~\"$topic\"})",
          "legendFormat": "",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Partitions where some replicas are not in sync. Should be 0. Anything above 0 means a broker is slow or down.",
      "id": 5,
      "title": "Under-Replicated Partitions",
