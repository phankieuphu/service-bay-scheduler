# Copy to .env (gitignored). Every variable and its default is in
# src/main/resources/application.properties.

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=billing_db
DB_SSLMODE=disable

SERVER_PORT=8084
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=billing-service

PAYMENT_SERVICE_URL=http://localhost:8085
# ISO code every bill is charged in; Stripe zero-decimal currencies such as vnd work.
BILLING_CURRENCY=usd

# Checkout validates customers and vehicles against these.
CUSTOMER_SERVICE_URL=http://localhost:8080
VEHICLE_SERVICE_URL=http://localhost:8081
# Charged when the vehicle's warranty has expired or it has none (placeholder amount).
BILLING_WARRANTY_FEE=50.00
BILLING_TIME_ZONE=Asia/Ho_Chi_Minh
