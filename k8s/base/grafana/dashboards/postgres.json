{
  "uid": "postgres",
  "title": "PostgreSQL",
  "description": "postgres-exporter (sidecar in the postgres pod): connections vs the pool budget, throughput, locks and cache efficiency.",
  "tags": [
    "postgres",
    "service-bay"
  ],
  "editable": true,
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "datname",
        "label": "database",
        "type": "query",
        "query": {
          "query": "label_values(pg_stat_database_numbackends, datname)",
          "refId": "datname"
        },
        "definition": "label_values(pg_stat_database_numbackends, datname)",
        "refresh": 2,
        "regex": "/^(?!template|postgres$).*/",
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Up",
      "description": "1 = the exporter can reach Postgres.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "max(pg_up)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Connections used",
      "description": "Backends across all databases / max_connections. The services' pools are budgeted to stay under 80% (see k8s tier overlays); above that, new pods can't connect.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 0.8
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "sum(pg_stat_database_numbackends) / max(pg_settings_max_connections)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 3,
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 4,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Transactions/s",
      "description": "Commits + rollbacks per second in the selected databases.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_xact_commit{datname=~\"$datname\"}[1m]) + rate(pg_stat_database_xact_rollback{datname=~\"$datname\"}[1m]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 4,
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 9,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Cache hit ratio",
      "description": "Share of block reads served from shared_buffers. Below ~99% on an OLTP load usually means shared_buffers is too small for the working set.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.95
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_blks_hit{datname=~\"$datname\"}[5m])) / (sum(rate(pg_stat_database_blks_hit{datname=~\"$datname\"}[5m])) + sum(rate(pg_stat_database_blks_read{datname=~\"$datname\"}[5m])))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 5,
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 14,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Deadlocks (1h)",
      "description": "Deadlocks detected in the last hour. Should be 0; TransferVehicle's SELECT ... FOR UPDATE is the likeliest source if not.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "sum(increase(pg_stat_database_deadlocks{datname=~\"$datname\"}[1h]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 6,
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 1
      }
    },
    {
      "type": "row",
      "title": "Connections",
      "id": 7,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Connections by database",
      "description": "Open backends per database vs max_connections.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (datname) (pg_stat_database_numbackends{datname=~\"$datname\"})",
          "legendFormat": "{{datname}}",
          "refId": "A"
        },
        {
          "expr": "max(pg_settings_max_connections)",
          "legendFormat": "max_connections",
          "refId": "B"
        }
      ],
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      }
    },
    {
      "type": "timeseries",
      "title": "Connections by state",
      "description": "From pg_stat_activity. Many 'idle in transaction' = a code path holding a transaction open; 'active' tracking the request rate is normal.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (state) (pg_stat_activity_count{datname=~\"$datname\"})",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ],
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      }
    },
    {
      "type": "row",
      "title": "Throughput",
      "id": 10,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Commits / rollbacks per second",
      "description": "Rollbacks include the ones the services issue on 404/409 paths, so a few are expected.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (datname) (rate(pg_stat_database_xact_commit{datname=~\"$datname\"}[1m]))",
          "legendFormat": "commit {{datname}}",
          "refId": "A"
        },
        {
          "expr": "sum by (datname) (rate(pg_stat_database_xact_rollback{datname=~\"$datname\"}[1m]))",
          "legendFormat": "rollback {{datname}}",
          "refId": "B"
        }
      ],
      "id": 11,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      }
    },
    {
      "type": "timeseries",
      "title": "Rows per second",
      "description": "Row-level work. 'returned' (rows scanned) far above 'fetched' means sequential scans \u2014 check for a missing index.",
      "fieldConfig": {
        "defaults": {
          "unit": "rowsps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_tup_fetched{datname=~\"$datname\"}[1m]))",
          "legendFormat": "fetched",
          "refId": "A"
        },
        {
          "expr": "sum(rate(pg_stat_database_tup_inserted{datname=~\"$datname\"}[1m]))",
          "legendFormat": "inserted",
          "refId": "B"
        },
        {
          "expr": "sum(rate(pg_stat_database_tup_updated{datname=~\"$datname\"}[1m]))",
          "legendFormat": "updated",
          "refId": "C"
        },
        {
          "expr": "sum(rate(pg_stat_database_tup_deleted{datname=~\"$datname\"}[1m]))",
          "legendFormat": "deleted",
          "refId": "D"
        }
      ],
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      }
    },
    {
      "type": "row",
      "title": "Contention & I/O",
      "id": 13,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Locks by mode",
      "description": "Held locks. RowShareLock/RowExclusiveLock spikes during transfers are the FOR UPDATE row locks; a steady climb of ExclusiveLock/AccessExclusiveLock means something is queueing.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (mode) (pg_locks_count{datname=~\"$datname\"})",
          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ],
      "id": 14,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      }
    },
    {
      "type": "timeseries",
      "title": "Longest open transaction",
      "description": "Age of the oldest transaction per state. Long 'idle in transaction' blocks vacuum and holds locks.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "max by (state) (pg_stat_activity_max_tx_duration{datname=~\"$datname\"})",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ],
      "id": 15,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      }
    },
    {
      "type": "timeseries",
      "title": "Block reads: cache vs disk",
      "description": "8 KiB blocks per second served from shared_buffers vs read from the OS/disk.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_blks_hit{datname=~\"$datname\"}[1m]))",
          "legendFormat": "cache hit",
          "refId": "A"
        },
        {
          "expr": "sum(rate(pg_stat_database_blks_read{datname=~\"$datname\"}[1m]))",
          "legendFormat": "disk read",
          "refId": "B"
        }
      ],
      "id": 16,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      }
    },
    {
      "type": "timeseries",
      "title": "Temp files & deadlocks",
      "description": "Temp bytes = sorts/hashes spilling past work_mem.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_temp_bytes{datname=~\"$datname\"}[5m]))",
          "legendFormat": "temp bytes/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(pg_stat_database_deadlocks{datname=~\"$datname\"}[5m]))",
          "legendFormat": "deadlocks/s",
          "refId": "B"
        },
        {
          "expr": "sum(rate(pg_stat_database_conflicts{datname=~\"$datname\"}[5m]))",
          "legendFormat": "conflicts/s",
          "refId": "C"
        }
      ],
      "id": 17,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      }
    },
    {
      "type": "row",
      "title": "Storage",
      "id": 18,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Database size",
      "description": "On-disk size per database.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "pg_database_size_bytes{datname=~\"$datname\"}",
          "legendFormat": "{{datname}}",
          "refId": "A"
        }
      ],
      "id": 19,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 41
      }
    },
    {
      "type": "row",
      "title": "Saturation (load tests)",
      "collapsed": false,
      "panels": [],
      "id": 20,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 49
      }
    },
    {
      "type": "timeseries",
      "title": "Postgres CPU vs limit",
      "description": "CPU cores the postgres container uses vs its limit (cAdvisor, Kubernetes only). Flat at the limit = Postgres is CPU-bound.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"service-bay\",container=\"postgres\"}[1m]))",
          "legendFormat": "used",
          "refId": "A"
        },
        {
          "expr": "sum(container_spec_cpu_quota{namespace=\"service-bay\",container=\"postgres\"} / container_spec_cpu_period{namespace=\"service-bay\",container=\"postgres\"})",
          "legendFormat": "limit",
          "refId": "B"
        }
      ],
      "id": 21,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 50
      }
    },
    {
      "type": "timeseries",
      "title": "CPU throttling by container",
      "description": "Share of CFS periods in which the container hit its CPU limit (cAdvisor, Kubernetes only). Sustained > 25% on postgres adds latency to every query.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (container) (rate(container_cpu_cfs_throttled_periods_total{namespace=\"service-bay\",container!=\"\"}[1m])) / sum by (container) (rate(container_cpu_cfs_periods_total{namespace=\"service-bay\",container!=\"\"}[1m]))",
          "legendFormat": "{{container}}",
          "refId": "A"
        }
      ],
      "id": 22,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 50
      }
    },
    {
      "type": "timeseries",
      "title": "DB pool wait per pod",
      "description": "Seconds per second that requests spend waiting for a free connection in each service's database/sql pool (go_sql_wait_duration_seconds_total). Above 0 = DB_MAX_OPEN_CONNS is exhausted.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
